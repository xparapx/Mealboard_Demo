 "nodes": {
  "t_api": {
   "c": "timer",
   "n": "mealboard-api.service",
   "s": "상시 · 8100",
   "d": "공개 FastAPI 를 부팅 시 자동 실행하고 죽으면 재시작한다. Funnel 이 이 포트를 인터넷에 낸다.",
   "row": 0
  },
  "t_mock": {
   "c": "timer",
   "n": "mealboard-mock / vision",
   "s": "상시 · 카메라(대역)",
   "d": "홈 Pi 는 mock, 학교 Pi 는 vision. 둘을 동시에 켜지 않는다 — queue.db 쓰기 주체는 하나.",
   "row": 1
  },
  "t_neis": {
   "c": "timer",
   "n": "mealboard-neis.timer",
   "s": "매일 새벽",
   "d": "fetch_neis.py 를 하루 한 번 oneshot 으로 돌린다.",
   "row": 2
  },
  "t_news": {
   "c": "timer",
   "n": "mealboard-news.timer",
   "s": "매일 06:10",
   "d": "fetch_news.py 를 하루 한 번. 05:45 report 뒤라 Hailo 충돌이 없다.",
   "row": 3
  },
  "t_report": {
   "c": "timer",
   "n": "mealboard-report.timer",
   "s": "05:45 · 14:20",
   "d": "아침 preview, 오후 recap 두 번. recap 은 rollup(14:10) 뒤.",
   "row": 4
  },
  "t_rollup": {
   "c": "timer",
   "n": "mealboard-rollup.timer",
   "s": "매일 14:10",
   "d": "점심이 끝난 뒤 최근 2일을 집계. Persistent=true 라 꺼져 있던 날도 보충 실행.",
   "row": 5
  },
  "t_admin": {
   "c": "timer",
   "n": "mealboard-admin.service",
   "s": "상시 · 8101",
   "d": "관리 앱. 127.0.0.1 에만 바인드하고 tailscale serve 8443 이 tailnet 안에서만 연결한다.",
   "row": 6
  },
  "t_serve": {
   "c": "timer",
   "n": "tailscale funnel / serve",
   "s": "443→8100 · 8443→8101",
   "d": "Funnel = 인터넷 공개, Serve = tailnet 전용. reset 명령은 절대 금지(Funnel 까지 지워짐).",
   "row": 7
  },
  "main": {
   "c": "job",
   "n": "app/main.py (uvicorn)",
   "s": "라우터 include + static",
   "d": "공개 서버의 조립 지점. 라우터들을 include 하고 마지막에 static 을 mount 한다(/api/* 가 먼저 잡히도록).",
   "row": 0
  },
  "mock": {
   "c": "job",
   "n": "jobs/mock_feed.py",
   "s": "vision/counter.py 대역",
   "d": "점심 인파 곡선을 흉내내 samples·zone_samples 를 쓴다. --scenario stall/gap 으로 병목·결측 상태를 재현.",
   "row": 1
  },
  "neis": {
   "c": "job",
   "n": "jobs/fetch_neis.py",
   "s": "NEIS → 영양 지표",
   "d": "NEIS 급식 API 를 호출해 주간 식단·영양 지표·탄소 추정을 meal.json 에 저장.",
   "row": 2
  },
  "news": {
   "c": "job",
   "n": "jobs/fetch_news.py",
   "s": "RSS 3건 → 본문 → 요약",
   "d": "기후 RSS 에서 3건 선정 → 본문 확보 → 로컬 LLM 한국어 요약(digest). 실패 시 DeepL 도입부 번역. 본문은 저장하지 않는다.",
   "row": 3
  },
  "report": {
   "c": "job",
   "n": "jobs/report.py",
   "s": "preview/recap 리포트",
   "d": "숫자·메뉴명만 LLM 에 넣어 헤드라인·본문을 만들고 스키마 검증 후 reports.db 에 저장. 실패 시 규칙 템플릿.",
   "row": 4
  },
  "rollup": {
   "c": "job",
   "n": "jobs/rollup.py",
   "s": "하루 단위 집계",
