   "row": 5
  },
  "admin": {
   "c": "job",
   "n": "app/admin (관리 앱)",
   "s": "auth·audit·stream·zones",
   "d": "tailnet 전용 두 번째 FastAPI. 신원 허용목록(fail-closed), 서비스 재시작, 메타 SSE, MJPEG opt-in, 구역 편집, 감사 로그.",
   "row": 6
  },
  "checkllm": {
   "c": "job",
   "n": "check_llm.py",
   "s": "스파이크 · 수동 1회",
