[Unit]
Description=Mealboard API (FastAPI + 정적 대시보드)
After=network.target

[Service]
User=__USER__
WorkingDirectory=/opt/mealboard
EnvironmentFile=/opt/mealboard/.env
ExecStart=/opt/mealboard/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port ${API_PORT}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
