# 실제 값은 .env 에 적는다 (.env 는 git 제외). 이 파일은 "어떤 키가 필요한가"만 알려준다.
# 주의: 값 뒤에 주석을 달지 말 것 — systemd 의 EnvironmentFile 은 줄 끝 주석을 값의 일부로 읽는다.
NEIS_KEY=
# 충청남도교육청
NEIS_ATPT_CODE=N10
# 공주고등학교 (schoolInfo API 로 조회한 값)
NEIS_SCHOOL_CODE=8140036
# 8000 은 Plant 프로젝트 setup_camera.py 가 쓰므로 피한다
API_PORT=8100
LUNCH_START=11:30
LUNCH_END=14:00
# 이슈 링크 한국어 번역 (jobs/fetch_news.py). 없으면 원문 영어 그대로 나간다
# DeepL API Free 키는 끝이 :fx 다 — 그걸 보고 무료/유료 엔드포인트를 고른다
DEEPL_API_KEY=
# Pi 접속 (CLAUDE.md §5). 값 뒤에 주석 금지
PI_USER=
PI_HOST=
# 인사이트 집계 (jobs/rollup.py) 창 — lunch 는 LUNCH_START~END 만, all 은 하루 전체 (스테이징 mock 용)
ROLLUP_WINDOW=lunch
# 표본 출처 표기 — mock | vision (insights.db 의 lunch_days.source, 실측 히트맵에 mock 이 섞이지 않게)
FEED_SOURCE=vision
# 관리 앱 (tailnet 전용). tailscale serve --https=8443 → 127.0.0.1:ADMIN_PORT
ADMIN_PORT=8101
# 관리자 Tailscale 로그인 허용목록 (쉼표 구분). 빈 값이면 tailnet 경로는 닫힌다
ADMIN_USERS=
# SSH 터널(127.0.0.1) 경로용 로컬 키. 빈 값이면 닫힌다. 생성: openssl rand -hex 16
ADMIN_LOCAL_KEY=
# vision 디버그 MJPEG 포트 (127.0.0.1 전용, 관리 앱이 중계)
DEBUG_PORT=8102
# 메타데이터 소켓 디렉터리. Pi 는 systemd RuntimeDirectory(/run/mealboard), 개발 PC 는 data/run
RUN_DIR=/run/mealboard
# 로컬 LLM (Hailo-10H GenAI) .hef 경로. 빈 값이면 LLM 없이 규칙 템플릿·DeepL 만 쓴다
LLM_HEF=
# 헤드라인 번역기 — deepl | local | none
TRANSLATOR=deepl
# The Guardian Content API 키 (기사 본문 확보용, 비상업 무료). 없으면 피드 요약으로 폴백
GUARDIAN_API_KEY=
