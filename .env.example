# 실제 값은 .env 에 적는다 (.env 는 git 제외). 이 파일은 "어떤 키가 필요한가"만 알려준다.
# 주의: 값 뒤에 주석을 달지 말 것 — systemd 의 EnvironmentFile 은 줄 끝 주석을 값의 일부로 읽는다.
NEIS_KEY=
# 충청남도교육청
NEIS_ATPT_CODE=N10
# 공주고등학교 (schoolInfo API 로 조회한 값)
NEIS_SCHOOL_CODE=8140036
# 8000 은 Plant 프로젝트 setup_camera.py 가 쓰므로 피한다
API_PORT=8100
LUNCH_START=11:30
LUNCH_END=13:40
# 석식 집계 창(09-16 중식/석식 분리) — ROLLUP_WINDOW=lunch 면 rollup 이 중식·석식 두 창을 각각 집계한다. 끝 시각은 09-16 사용자 실측(중식 13:40·석식 18:10)
DINNER_START=17:00
DINNER_END=18:10
# 수집 시간창(09-04 운영 규칙) — 카메라 노드는 이 창 안에서만 세고, 창 밖은 더미 곡선 + 화면 '더미데이터' 띠. 'HH:MM-HH:MM 라벨' 을 ; 로 나열. 겹치면 시작 거부
MEAL_WINDOWS=11:20-12:30 3학년 점심;12:30-13:40 1·2학년 점심;17:00-18:10 석식
# 이슈 링크 한국어 번역 (jobs/fetch_news.py). 없으면 원문 영어 그대로 나간다
# DeepL API Free 키는 끝이 :fx 다 — 그걸 보고 무료/유료 엔드포인트를 고른다
DEEPL_API_KEY=
# Pi 접속 (CLAUDE.md §5). 값 뒤에 주석 금지
PI_USER=
PI_HOST=
# 인사이트 집계 (jobs/rollup.py) 창 모드 — lunch 는 끼니별 두 창(중식 LUNCH_*·석식 DINNER_*), all 은 하루 전체 한 행 (스테이징 mock 용)
ROLLUP_WINDOW=lunch
# 표본 출처 표기 — mock | vision (insights.db 의 lunch_days.source, 실측 히트맵에 mock 이 섞이지 않게)
FEED_SOURCE=vision
# 관리 앱 (tailnet 전용). tailscale serve --https=8443 → 127.0.0.1:ADMIN_PORT
ADMIN_PORT=8101
# 관리자 Tailscale 로그인 허용목록 (쉼표 구분). 빈 값이면 tailnet 경로는 닫힌다
ADMIN_USERS=
# SSH 터널(127.0.0.1) 경로용 로컬 키. 빈 값이면 닫힌다. 생성: openssl rand -hex 16
ADMIN_LOCAL_KEY=
# vision 디버그 MJPEG 포트 (127.0.0.1 전용, 관리 앱이 중계)
DEBUG_PORT=8102
# 카메라 카운팅 노드 (vision/counter.py). 소스: picamera | webcam:0 | file:경로. 홈 Pi 는 picamera 금지(Plant 카메라와 배타)
VIDEO_SOURCE=picamera
# imx708: 2304x1296 = 센서 전체 화각(2×2 비닝). 1536x864 는 중앙 크롭(화각 2/3) — 쓰지 말 것
VISION_SIZE=2304x1296
VISION_FPS=5
VISION_IMGSZ=640
VISION_CONF=0.35
# λ(처리율) 이동합 창(초). 기본 120 — 2분(09-16). 급식 초반 요동이 크면 300 으로
RATE_WINDOW_SEC=180
# 체류 실측 과소 편향 보정 배율 — 트랙 끊김으로 짧게 재진다. 수동 실측 대조로 조정(1.0 = 보정 없음)
DWELL_BIAS=1.0
# ultralytics 가중치 (사람 클래스만 쓴다). Pi: data/models/yolo11n.pt
YOLO_WEIGHTS=data/models/yolo11n.pt
# 메타데이터 소켓 디렉터리. Pi 는 systemd RuntimeDirectory(/run/mealboard), 개발 PC 는 data/run
RUN_DIR=/run/mealboard
# 로컬 LLM (Hailo-10H GenAI) .hef 경로. 빈 값이면 LLM 없이 규칙 템플릿·DeepL 만 쓴다
LLM_HEF=
# 리포트(예보·결산)에도 LLM 을 쓸지 — 0 이면 규칙 템플릿(기본). 09-04 스파이크에서 1.5B 모델은 리포트 문장을 지어내 0 으로 둔다. 기사 요약은 이 값과 무관하게 LLM(영어) → DeepL
LLM_REPORT=0
# LLM 에 넣는 기사 본문 글자 상한 — 09-04 스파이크(Qwen2.5-1.5B, HailoRT 5.1.1): 4,000자까지 네 줄 형식이 안정, 6,000자부터 흔들림 → 3200 권장
LLM_CONTEXT_CHARS=3200
# 헤드라인 번역기 — deepl | local | none
TRANSLATOR=deepl
# The Guardian Content API 키 (기사 본문 확보용, 비상업 무료). 없으면 피드 요약으로 폴백
GUARDIAN_API_KEY=

# 공개 터널 — Cloudflare Tunnel(원격 관리형). Zero Trust → Networks → Tunnels → 터널 만들기 → 토큰. 비어 있으면 mealboard-cloudflared 유닛을 켜지 않는다.
# 학교 망이 Tailscale 도쿄 릴레이를 막아 Funnel 이 끊긴 뒤(2026-09-03) 정식 공개 경로. 포트 7844 가 열려 있어야 한다(학교 망 확인 완료)
CF_TUNNEL_TOKEN=
# 관리 앱 외부 접속(09-11) — 터널 경로 admin.kjhs-meal.com → HTTP 127.0.0.1:8101 앞에 Cloudflare Access(이메일 일회용 코드)를 세운다.
# TEAM = Zero Trust 팀 도메인(예: mealboard.cloudflareaccess.com), AUD = 그 Access 애플리케이션의 Audience 태그. 둘 중 하나라도 비면 그 경로는 닫힌다
CF_ACCESS_TEAM=
CF_ACCESS_AUD=
