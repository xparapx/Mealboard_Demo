# 실제 값은 .env 에 적는다 (.env 는 git 제외). 이 파일은 "어떤 키가 필요한가"만 알려준다.
# 주의: 값 뒤에 주석을 달지 말 것 — systemd 의 EnvironmentFile 은 줄 끝 주석을 값의 일부로 읽는다.
NEIS_KEY=
# 충청남도교육청
NEIS_ATPT_CODE=N10
# 공주고등학교 (schoolInfo API 로 조회한 값)
NEIS_SCHOOL_CODE=8140036
# 8000 은 Plant 프로젝트 setup_camera.py 가 쓰므로 피한다
API_PORT=8100
LUNCH_START=11:30
LUNCH_END=14:00
# Pi 접속 (CLAUDE.md §5). 값 뒤에 주석 금지
PI_USER=
PI_HOST=
